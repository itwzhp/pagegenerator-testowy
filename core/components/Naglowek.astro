---
import { site } from '../lib/site';
---

<header class="naglowek">
  <div class="zhp-kontener">
    <a class="nazwa" href="/">{site.nazwa}</a>
  </div>
</header>

<style>
  .naglowek {
    background: var(--zhp-kolor-podstawowy);
    padding-block: var(--zhp-odstep-3);
  }
  .nazwa {
    color: var(--zhp-kolor-tla);
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
  }
</style>
